---
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
import '@styles/global.css';
import { buildSeo, type SeoProps } from '@utils/seo';

type Props = SeoProps;
const seo = buildSeo(Astro.props);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050605" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonicalUrl} />
    {seo.imageUrl && <meta property="og:image" content={seo.imageUrl} />}
    <meta name="twitter:card" content={seo.imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
