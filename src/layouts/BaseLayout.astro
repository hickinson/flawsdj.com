---
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
import { artistProfile } from '@data/artistProfile';
import { officialProfileLinks } from '@data/links';
import '@styles/global.css';
import { publicAssetExists } from '@utils/assets';
import { buildSeo, type SeoProps } from '@utils/seo';

type StructuredData = Record<string, unknown>;

type Props = SeoProps & {
  structuredData?: StructuredData | StructuredData[];
};

const { structuredData: pageStructuredData } = Astro.props;
const seo = buildSeo(Astro.props);
const heroImageUrl = publicAssetExists(artistProfile.heroImage)
  ? new URL(artistProfile.heroImage, artistProfile.siteUrl).toString()
  : undefined;
const artistStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: artistProfile.name,
  alternateName: 'FLAWS DJ',
  url: artistProfile.siteUrl,
  genre: artistProfile.genres,
  sameAs: officialProfileLinks.map((link) => link.href),
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
  email: artistProfile.bookingEmail,
};
const structuredDataEntries = [
  artistStructuredData,
  ...(Array.isArray(pageStructuredData)
    ? pageStructuredData
    : pageStructuredData
      ? [pageStructuredData]
      : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <link rel="icon" href="/brand/flaws-social-avatar.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content={seo.robots} />
    <meta property="og:site_name" content={artistProfile.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:url" content={seo.canonicalUrl} />
    {seo.imageUrl && <meta property="og:image" content={seo.imageUrl} />}
    <meta name="twitter:card" content={seo.imageUrl ? 'summary_large_image' : 'summary'} />
    {structuredDataEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-fog focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:uppercase focus:tracking-[0.2em] focus:text-ink" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
