---
type Props = {
  eyebrow?: string;
  title: string;
  copy?: string;
};
const { eyebrow, title, copy } = Astro.props;
---

<div class="mb-8 max-w-3xl">
  {eyebrow && <p class="mb-3 text-xs font-bold uppercase tracking-[0.42em] text-acid">{eyebrow}</p>}
  <h2 class="text-3xl font-black uppercase tracking-[-0.04em] text-fog sm:text-5xl">{title}</h2>
  {copy && <p class="mt-4 text-base leading-7 text-muted sm:text-lg">{copy}</p>}
</div>
