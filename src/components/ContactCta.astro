---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { primaryLinks } from '@data/links';
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl rounded-[2rem] border border-fog/10 bg-fog/[0.04] p-6 sm:p-10">
    <SectionHeading eyebrow="Contact" title="Booking, press and direct requests" copy="No public email address or form backend has been approved for Phase 2. Use the official public profiles below until verified contact details are supplied." />
    <div class="grid gap-4 md:grid-cols-3">
      {['Booking enquiries', 'Press enquiries', 'General contact'].map((label) => (
        <div class="rounded-3xl border border-fog/10 bg-ink/45 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-muted">{label}</p>
          <p class="mt-4 text-sm leading-7 text-muted">Approved public contact details pending. Add a mailto link only after the address is explicitly approved.</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      {primaryLinks.map((link) => <ButtonLink href={link.href} external>{link.label}</ButtonLink>)}
    </div>
  </div>
</section>
