---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { primaryLinks } from '@data/links';
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="Links" title="Official channels" copy="Only approved public profiles are linked. Additional music-platform URLs can be added when supplied." />
    <div class="grid gap-4 md:grid-cols-3">
      {primaryLinks.map((link) => <ButtonLink href={link.href} external>{link.label}</ButtonLink>)}
    </div>
  </div>
</section>
