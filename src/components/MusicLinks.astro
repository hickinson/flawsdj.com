---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { futureMusicLinks, primaryLinks } from '@data/links';
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="Links" title="Official channels" copy="Only approved public profiles are linked. Music-platform URLs can be added here when supplied." />
    <div class="grid gap-4 md:grid-cols-3">
      {primaryLinks.map((link) => <ButtonLink href={link.href} external>{link.label}</ButtonLink>)}
    </div>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Future music links">
      {futureMusicLinks.map((link) => (
        <div class="rounded-3xl border border-fog/10 bg-fog/[0.02] p-5">
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-fog">{link.label}</p>
          <p class="mt-3 text-sm leading-6 text-muted">{link.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>
