---
import SectionHeading from './SectionHeading.astro';
import SoundCloudEmbed from './SoundCloudEmbed.astro';
import { musicDestinations } from '@data/links';
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow="Listen"
      title="SoundCloud playlists"
      copy="Explore selected releases, labels and collaborations, plus podcast and interview appearances."
    />
    <div class="grid gap-5 lg:grid-cols-2">
      {musicDestinations.map((destination) => <SoundCloudEmbed destination={destination} />)}
    </div>
  </div>
</section>