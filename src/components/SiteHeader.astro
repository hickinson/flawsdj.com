---
import { artistProfile } from '@data/artistProfile';

const navItems = [
  { label: 'Music', href: '/music/' },
  { label: 'About', href: '/about/' },
  { label: 'Gigs', href: '/shows/' },
  { label: 'EPK', href: '/epk/' },
  { label: 'Contact', href: '/contact/' },
];
---

<header class="sticky top-0 z-30 border-b border-fog/10 bg-ink/88 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="focus-ring group inline-flex items-center gap-3 rounded-full" aria-label={`${artistProfile.name} home`}>
      <img class="h-5 w-auto" src="/brand/flaws-mark-white.svg" alt="" width="17" height="20" aria-hidden="true" />
      <span class="text-sm font-black uppercase tracking-[0.32em] text-fog transition group-hover:text-muted">{artistProfile.name}</span>
    </a>

    <nav class="hidden items-center gap-5 md:flex" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a class="focus-ring rounded-full text-xs font-bold uppercase tracking-[0.22em] text-muted transition hover:text-fog" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/" class="focus-ring hidden rounded-full border border-fog/20 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-fog transition hover:border-fog hover:bg-fog hover:text-ink md:inline-flex">Booking</a>

      <details class="group relative md:hidden">
        <summary class="focus-ring flex cursor-pointer list-none items-center gap-2 rounded-full border border-fog/20 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-fog transition hover:border-fog [&::-webkit-details-marker]:hidden">
          Menu
          <svg class="h-3.5 w-3.5 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>

        <div class="absolute right-0 top-full z-40 mt-3 w-56 rounded-2xl border border-fog/10 bg-panel/95 p-2 shadow-2xl shadow-black/70 backdrop-blur-xl">
          <nav class="grid gap-1" aria-label="Mobile navigation">
            {navItems.map((item) => (
              <a class="focus-ring rounded-xl px-4 py-3 text-xs font-bold uppercase tracking-[0.22em] text-muted transition hover:bg-fog/10 hover:text-fog" href={item.href}>{item.label}</a>
            ))}
            <a class="focus-ring mt-1 rounded-xl bg-fog px-4 py-3 text-xs font-bold uppercase tracking-[0.22em] text-ink transition hover:bg-fog/85" href="/contact/">Booking</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
