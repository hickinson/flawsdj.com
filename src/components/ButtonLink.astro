---
type Props = {
  href: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
};
const { href, label, variant = 'secondary', class: className = '' } = Astro.props;
const styles = {
  primary: 'border-acid bg-acid text-ink hover:bg-transparent hover:text-acid',
  secondary: 'border-fog/20 bg-fog/5 text-fog hover:border-acid hover:text-acid',
  ghost: 'border-transparent text-muted hover:text-acid',
};
---

<a href={href} class={`focus-ring inline-flex items-center justify-center rounded-full border px-5 py-3 text-xs font-bold uppercase tracking-[0.28em] transition ${styles[variant]} ${className}`}>
  <slot>{label}</slot>
</a>
