---
import ButtonLink from './ButtonLink.astro';
import type { Release } from '@data/types';

type Props = { release: Release };
const { release } = Astro.props;
---

<article class="flex min-h-full flex-col rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-5 transition hover:border-fog/25">
  <div class="flex aspect-square flex-col justify-between rounded-[1.5rem] border border-fog/10 bg-[linear-gradient(140deg,rgba(245,245,245,0.1),rgba(24,24,24,0.82)_48%,rgba(0,0,0,0.96))] p-5">
    <p class="text-xs font-bold uppercase tracking-[0.28em] text-muted">{release.label ?? release.type}</p>
    <p class="text-xs uppercase tracking-[0.24em] text-muted">{release.artwork ?? 'Artwork pending'}</p>
  </div>
  <div class="flex flex-1 flex-col pt-6">
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-muted">{release.type} · {release.year}</p>
    <h3 class="mt-3 text-3xl font-black uppercase leading-none tracking-[-0.05em] text-fog">{release.title}</h3>
    <p class="mt-4 flex-1 text-sm leading-7 text-muted">{release.summary}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {!release.isPlaceholder && <ButtonLink href={`/music/${release.slug}/`} variant="primary">Details</ButtonLink>}
      {release.links.map((link) => <ButtonLink href={link.href} external={link.href.startsWith('http')} disabled={link.isPlaceholder}>{link.label}</ButtonLink>)}
    </div>
  </div>
</article>
