---
import ButtonLink from './ButtonLink.astro';
import { artistProfile } from '@data/artistProfile';
import { soundCloudProfileLink } from '@data/links';
import { publicAssetExists } from '@utils/assets';

const hasHeroImage = publicAssetExists(artistProfile.heroImage);
---

<section class="relative min-h-[calc(100svh-73px)] overflow-hidden px-4 py-12 sm:px-6 lg:px-8 lg:py-10">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_70%_20%,rgba(245,245,245,0.12),transparent_24rem)]"></div>
  <div class="mx-auto grid min-h-[calc(100svh-8rem)] max-w-7xl gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div class="py-8 lg:py-10">
      <p class="mb-6 text-xs font-bold uppercase tracking-[0.48em] text-muted">Official artist website</p>
      <h1 class="max-w-5xl text-[clamp(4.8rem,17vw,15rem)] font-black uppercase leading-[0.76] tracking-[-0.1em] text-fog">{artistProfile.name}</h1>
      <p class="mt-8 text-lg font-semibold uppercase tracking-[0.3em] text-fog">{artistProfile.artistType}</p>
      <p class="mt-5 max-w-xl text-lg leading-8 text-muted">{artistProfile.tagline}</p>
      <div class="mt-10 flex flex-wrap gap-3" aria-label="Primary actions">
        <ButtonLink href={soundCloudProfileLink.href} variant="primary" external>Listen on SoundCloud</ButtonLink>
        <ButtonLink href="/shows/">Gigs</ButtonLink>
        <ButtonLink href="/epk/">EPK</ButtonLink>
        <ButtonLink href="/contact/">Booking</ButtonLink>
      </div>
    </div>
    <figure class="relative rounded-[2rem] border border-fog/10 bg-panel/35 p-4 shadow-2xl shadow-black/60">
      {hasHeroImage ? (
        <img class="aspect-[4/5] w-full rounded-[1.5rem] object-cover grayscale" src={artistProfile.heroImage} alt={artistProfile.heroImageAlt} loading="eager" decoding="async" />
      ) : (
        <div class="flex aspect-[4/5] flex-col justify-between rounded-[1.5rem] border border-fog/10 bg-[linear-gradient(135deg,rgba(245,245,245,0.13),rgba(24,24,24,0.7)_42%,rgba(0,0,0,0.92))] p-6" role="img" aria-label="FLAWS artist identity panel">
          <p class="text-xs font-bold uppercase tracking-[0.34em] text-muted">FLAWS</p>
          <div>
            <p class="text-xs uppercase tracking-[0.28em] text-muted">Netherlands</p>
            <p class="mt-4 max-w-sm text-2xl font-black uppercase leading-none tracking-[-0.04em] text-fog">Hypnotic. Deep. Rhythm-led.</p>
          </div>
        </div>
      )}
    </figure>
  </div>
</section>