---
import type { Show } from '@data/types';

type Props = { show: Show };
const { show } = Astro.props;
const dateLabel = show.date === 'TBC' ? 'TBC' : new Intl.DateTimeFormat('en', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(show.date));
---

<article class="grid gap-4 border-t border-fog/10 py-6 first:border-t-0 md:grid-cols-[0.24fr_1fr_auto] md:items-center">
  <time class="text-xs font-bold uppercase tracking-[0.28em] text-muted" datetime={show.date}>{dateLabel}</time>
  <div>
    <h3 class="text-2xl font-black uppercase tracking-[-0.04em] text-fog">{show.title}</h3>
    <p class="mt-2 text-xs font-bold uppercase tracking-[0.18em] text-muted">{show.venue} · {show.city}</p>
  </div>
  {show.ticketUrl ? <a class="focus-ring rounded-full border border-fog/20 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-fog transition hover:border-fog hover:bg-fog/10" href={show.ticketUrl} target="_blank" rel="noreferrer">Tickets</a> : <span class="text-xs font-bold uppercase tracking-[0.22em] text-muted">{show.status}</span>}
</article>
