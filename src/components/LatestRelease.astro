---
import ButtonLink from './ButtonLink.astro';
import ReleaseArtwork from './ReleaseArtwork.astro';
import SectionHeading from './SectionHeading.astro';
import { featuredRelease } from '@data/releases';
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="Featured release" title="Selected music" />
    <div class="grid gap-8 rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-5 md:grid-cols-[0.82fr_1.18fr] md:p-8">
      <ReleaseArtwork release={featuredRelease} priority />
      <div class="self-end">
        <p class="text-xs font-bold uppercase tracking-[0.35em] text-muted">{featuredRelease.type} · {featuredRelease.status}</p>
        <h3 class="mt-4 text-4xl font-black uppercase tracking-[-0.05em] text-fog sm:text-6xl">{featuredRelease.title}</h3>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{featuredRelease.summary}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href={`/music/${featuredRelease.slug}/`} variant="primary">Release page</ButtonLink>
          <ButtonLink href="/music/">Music archive</ButtonLink>
        </div>
      </div>
    </div>
  </div>
</section>