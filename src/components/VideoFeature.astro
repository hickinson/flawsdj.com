---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { videos, videosEmptyState } from '@data/videos';
const video = videos[0];
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="Mixes" title="Recorded sessions" copy="DJ mixes and live recordings will be linked here as lightweight external resources." />
    <div class="rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-5 md:p-8">
      {video ? (
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-muted">{video.type}</p>
          <h3 class="mt-3 text-3xl font-black uppercase tracking-[-0.04em] text-fog">{video.title}</h3>
          <p class="mt-4 text-base leading-7 text-muted">{video.description}</p>
          {video.href && <ButtonLink href={video.href} class="mt-8" external>Open link</ButtonLink>}
        </div>
      ) : (
        <p class="text-2xl font-black uppercase tracking-[-0.04em] text-fog">{videosEmptyState}</p>
      )}
    </div>
  </div>
</section>
