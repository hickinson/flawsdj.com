---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { videos } from '@data/videos';
const video = videos[0];
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="Video" title="Visual signal" copy="Feature slots use thumbnails and external links so embeds never slow the first page load." />
    <div class="grid gap-8 rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-5 md:grid-cols-[1.2fr_0.8fr] md:p-8">
      <div class="flex aspect-video flex-col justify-between rounded-[1.5rem] border border-fog/10 bg-gradient-to-br from-fog/10 via-ash to-acid/10 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-muted">Thumbnail placeholder</p>
        <p class="text-xs uppercase tracking-[0.24em] text-acid">{video.thumbnail}</p>
      </div>
      <div class="self-end">
        <h3 class="text-3xl font-black uppercase tracking-[-0.04em] text-fog">{video.title}</h3>
        <p class="mt-4 text-base leading-7 text-muted">{video.description}</p>
        <ButtonLink href={video.href} class="mt-8">Open video link</ButtonLink>
      </div>
    </div>
  </div>
</section>
