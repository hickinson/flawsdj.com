---
import ButtonLink from './ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { artistProfile } from '@data/artistProfile';
import { epkAssets, epkDownloadsNote } from '@data/epkAssets';
import { primaryLinks } from '@data/links';
import { pressImages, pressQuotes } from '@data/press';
import { publicAssetExists } from '@utils/assets';

const availableMediaAssets = pressImages.flatMap((asset) => {
  if (!asset.href || !publicAssetExists(asset.href)) return [];

  return [{ ...asset, href: asset.href }];
});

const hasPressImages = availableMediaAssets.length > 0;
const hasEpkAssets = epkAssets.length > 0;
const hasPressQuotes = pressQuotes.length > 0;
const showEpkLink = Astro.url.pathname !== '/epk/';
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <SectionHeading eyebrow="EPK" title="Press / media essentials" copy="Official biography, highlights, approved media assets and profile links for FLAWS." />

    <div class="grid gap-4 lg:grid-cols-4">
      {artistProfile.highlights.map((highlight) => (
        <div class="rounded-3xl border border-fog/10 bg-fog/[0.03] p-5">
          <p class="text-sm leading-7 text-muted">{highlight}</p>
        </div>
      ))}
    </div>

    {hasPressImages ? (
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {availableMediaAssets.map((asset) => (
          <figure class="rounded-3xl border border-fog/10 bg-fog/[0.03] p-3">
            <img class="aspect-[4/5] w-full rounded-[1.25rem] object-cover" src={asset.href} alt={asset.alt} loading="lazy" decoding="async" />
            <figcaption class="p-3">
              <p class="text-xs font-bold uppercase tracking-[0.28em] text-fog">{asset.label}</p>
              <p class="mt-2 text-xs leading-5 text-muted">{asset.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-3xl border border-fog/10 bg-fog/[0.03] p-5 text-sm leading-7 text-muted">Approved press photography will be available here soon.</p>
    )}

    {hasEpkAssets ? (
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {epkAssets.map((asset) => (
          <ButtonLink href={asset.href} external={asset.href.startsWith('http')}>{asset.label}</ButtonLink>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-3xl border border-fog/10 bg-fog/[0.03] p-5 text-sm leading-7 text-muted">{epkDownloadsNote}</p>
    )}

    {hasPressQuotes && (
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {pressQuotes.map((quote) => (
          <blockquote class="rounded-3xl border border-fog/10 bg-fog/[0.03] p-6">
            <p class="text-lg leading-8 text-fog">“{quote.quote}”</p>
            <cite class="mt-5 block text-xs font-bold not-italic uppercase tracking-[0.28em] text-muted">{quote.source}</cite>
          </blockquote>
        ))}
      </div>
    )}

    <div class="mt-8 flex flex-wrap gap-3">
      {showEpkLink && <ButtonLink href="/epk/" variant="primary">Open EPK</ButtonLink>}
      {primaryLinks.map((link) => (
        <ButtonLink href={link.href} external>{link.label}</ButtonLink>
      ))}
    </div>
  </div>
</section>
