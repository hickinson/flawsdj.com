---
import ShowsList from '@components/ShowsList.astro';
import { shows } from '@data/shows';
import BaseLayout from '@layouts/BaseLayout.astro';
import { buildShowStructuredData, getUpcomingShows } from '@utils/shows';

const structuredData = buildShowStructuredData(getUpcomingShows(shows));
---

<BaseLayout
  title="Gigs"
  description="Confirmed FLAWS event dates, official event links and touring information."
  pathname="/shows/"
  structuredData={structuredData}
>
  <ShowsList variant="full" />
</BaseLayout>
