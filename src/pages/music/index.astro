---
import MusicLinks from '@components/MusicLinks.astro';
import ReleaseCard from '@components/ReleaseCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import VideoFeature from '@components/VideoFeature.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mixes, mixesEmptyState, releases } from '@data/releases';
---

<BaseLayout title="Music" description="Music archive for FLAWS, including verified release facts and space for approved mixes and live recordings." pathname="/music/">
  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading eyebrow="Music" title="Releases" copy="Only verified release facts are included. Artwork, track lists and external links should be added only when approved." />
      <div class="grid gap-5 md:grid-cols-2">
        {releases.map((release) => <ReleaseCard release={release} />)}
      </div>
      <div class="mt-14">
        <SectionHeading eyebrow="Mixes / live sets" title="Sessions" copy="Approved recordings will be added as lightweight external links when supplied." />
        {mixes.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2">
            {mixes.map((release) => <ReleaseCard release={release} />)}
          </div>
        ) : (
          <p class="rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-6 text-2xl font-black uppercase tracking-[-0.04em] text-fog">{mixesEmptyState}</p>
        )}
      </div>
    </div>
  </section>
  <VideoFeature />
  <MusicLinks />
</BaseLayout>
