---
import ReleaseCard from '@components/ReleaseCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import SoundCloudPlayers from '@components/SoundCloudPlayers.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { releases } from '@data/releases';
---

<BaseLayout title="Music" description="Listen to FLAWS on SoundCloud and explore selected release context." pathname="/music/">
  <SoundCloudPlayers />
  <section class="px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Catalogue"
        title="Selected releases"
        copy="Verified release context from the FLAWS catalogue. SoundCloud remains the main listening destination."
      />
      <div class="grid gap-5 md:grid-cols-2">
        {releases.map((release) => <ReleaseCard release={release} />)}
      </div>
    </div>
  </section>
</BaseLayout>