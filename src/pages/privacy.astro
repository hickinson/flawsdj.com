---
import ButtonLink from '@components/ButtonLink.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { artistProfile } from '@data/artistProfile';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy" description="Privacy information for the official FLAWS artist website, including the use of embedded SoundCloud players." pathname="/privacy/">
  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <SectionHeading eyebrow="Privacy" title="How this site handles data" copy="A short explanation of the third-party services used by the FLAWS website." />
      <div class="space-y-8 rounded-[2rem] border border-fog/10 bg-fog/[0.03] p-6 text-base leading-8 text-muted sm:p-10">
        <div>
          <h2 class="text-xl font-black uppercase tracking-[-0.03em] text-fog">SoundCloud players</h2>
          <p class="mt-4">
            The Music page offers two embedded SoundCloud playlist players. On your first visit, SoundCloud remains disconnected until you choose “Enable SoundCloud playlists”. That choice loads both players and is stored in your browser’s local storage so they can load automatically on later visits. You can disable automatic loading from the Music page, which clears the saved choice and reloads the page.
          </p>
          <p class="mt-4">
            Loading the players connects your browser to SoundCloud. SoundCloud may then collect usage data and use cookies or similar technologies under its own policies. The players are configured not to start audio automatically.
          </p>
          <ButtonLink class="mt-6" href="https://soundcloud.com/pages/cookies" external>SoundCloud cookie policy</ButtonLink>
        </div>
        <div>
          <h2 class="text-xl font-black uppercase tracking-[-0.03em] text-fog">External websites</h2>
          <p class="mt-4">
            Links to SoundCloud, Resident Advisor, Parabel, Substack and social platforms open third-party websites. Those services are responsible for their own privacy and cookie practices.
          </p>
        </div>
        <div>
          <h2 class="text-xl font-black uppercase tracking-[-0.03em] text-fog">Contact</h2>
          <p class="mt-4">
            This site does not provide an account or contact form. Booking, press and general enquiries are handled through the published representation email.
          </p>
          <a class="focus-ring mt-5 inline-flex rounded-sm font-bold text-fog underline underline-offset-4" href={`mailto:${artistProfile.bookingEmail}`}>{artistProfile.bookingEmail}</a>
        </div>
        <p class="border-t border-fog/10 pt-6 text-xs uppercase tracking-[0.22em] text-muted">Last updated: July 2026</p>
      </div>
    </div>
  </section>
</BaseLayout>
